# Shared
MUSICPILOT_VERSION=0.1.0

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1/plugin/musicpilot

# Backend
MUSICPILOT_APP_NAME=MusicPilot Backend
MUSICPILOT_API_PREFIX=/api/v1/plugin/musicpilot
MUSICPILOT_HOST=127.0.0.1
MUSICPILOT_PORT=8000
MUSICPILOT_DEBUG=false
MUSICPILOT_METADATA_PROVIDER_MODE=seed
MUSICPILOT_METADATA_PROVIDER_TIMEOUT_SECONDS=15
MUSICPILOT_METADATA_MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICPILOT_METADATA_PROVIDER_USER_AGENT=MusicPilot/0.1.0 (local)
MUSICPILOT_METADATA_CACHE_ENABLED=true
MUSICPILOT_METADATA_CACHE_MAXSIZE=512
MUSICPILOT_METADATA_SEARCH_CACHE_TTL_SECONDS=1800
MUSICPILOT_METADATA_DETAIL_CACHE_TTL_SECONDS=21600
MUSICPILOT_CHART_PROVIDER_MODE=mock
MUSICPILOT_CHART_PROVIDER_TIMEOUT_SECONDS=15
MUSICPILOT_CHART_LISTENBRAINZ_BASE_URL=https://api.listenbrainz.org
MUSICPILOT_CHART_PROVIDER_USER_AGENT=MusicPilot/0.1.0 (local)
MUSICPILOT_CHART_LISTENBRAINZ_RANGE=week
MUSICPILOT_CHART_LISTENBRAINZ_COUNT=20
MUSICPILOT_CHART_CACHE_ENABLED=true
MUSICPILOT_CHART_CACHE_MAXSIZE=256
MUSICPILOT_CHART_CACHE_TTL_SECONDS=900
MUSICPILOT_SUBSCRIPTION_SCHEDULER_ENABLED=true
MUSICPILOT_SUBSCRIPTION_SCHEDULER_POLL_SECONDS=30
MUSICPILOT_SUBSCRIPTION_SCHEDULER_DEFAULT_INTERVAL_MINUTES=360

# Host integration
# 推荐把真实宿主 token 保存在本地私有环境里，再手动导出到 MUSICPILOT_HOST_AUTH_TOKEN。
MUSICPILOT_HOST_INTEGRATION_ENABLED=false
MUSICPILOT_HOST_BASE_URL=http://127.0.0.1:3000
MUSICPILOT_HOST_AUTH_TOKEN=
MUSICPILOT_HOST_AUTH_MODE=x_api_key
MUSICPILOT_HOST_API_KEY_HEADER_NAME=X-API-KEY
MUSICPILOT_HOST_VERIFICATION_STATE=unverified
MUSICPILOT_HOST_TIMEOUT_SECONDS=20
MUSICPILOT_HOST_VERIFY_TLS=true
MUSICPILOT_HOST_HEALTH_PATH=/api/v1/search/last
MUSICPILOT_HOST_SITES_PATH=/api/v1/site
MUSICPILOT_HOST_SEARCH_TITLE_PATH=/api/v1/search/title
MUSICPILOT_HOST_SEARCH_MEDIA_PATH=/api/v1/search/media
MUSICPILOT_HOST_SEARCH_LAST_PATH=/api/v1/search/last
MUSICPILOT_HOST_DOWNLOADERS_PATH=/api/v1/download/clients
MUSICPILOT_HOST_DOWNLOAD_ADD_PATH=/api/v1/download/add
MUSICPILOT_HOST_DOWNLOAD_MEDIA_PATH=/api/v1/download/
MUSICPILOT_HOST_HISTORY_DOWNLOAD_PATH=/api/v1/history/download
MUSICPILOT_HOST_HISTORY_TRANSFER_PATH=/api/v1/history/transfer
MUSICPILOT_HOST_HISTORY_SYNC_RETRY_ATTEMPTS=3
MUSICPILOT_HOST_HISTORY_SYNC_RETRY_INTERVAL_SECONDS=1
MUSICPILOT_HOST_HANDOFF_PENDING_TTL_SECONDS=120
MUSICPILOT_HOST_TRANSFER_NAME_PATH=/api/v1/transfer/name
MUSICPILOT_HOST_TRANSFER_QUEUE_PATH=/api/v1/transfer/queue
MUSICPILOT_HOST_TRANSFER_MANUAL_PATH=/api/v1/transfer/manual
MUSICPILOT_HOST_TRANSFER_NOW_PATH=/api/v1/transfer/now
MUSICPILOT_HOST_VALIDATION_MATRIX_PATH=backend/data/host_validation_matrix.latest.json
MUSICPILOT_HOST_SEARCH_MODE=mock
MUSICPILOT_HOST_DISPATCH_MODE=mock
MUSICPILOT_HOST_ORGANIZE_MODE=mock
MUSICPILOT_HOST_DISPATCH_VALIDATE_CLIENTS=true
MUSICPILOT_HOST_ASSUME_HEALTHY=
MUSICPILOT_HOST_ASSUME_SEARCH_AVAILABLE=
MUSICPILOT_HOST_ASSUME_DISPATCH_AVAILABLE=
MUSICPILOT_HOST_ASSUME_ORGANIZE_AVAILABLE=
MUSICPILOT_HOST_ASSUME_DOWNLOADERS_AVAILABLE=
MUSICPILOT_HOST_ASSUME_SITES_VISIBLE=

# Optional local helper vars for shell wrappers only; the app itself reads MUSICPILOT_HOST_*.
MUSICPILOT_REAL_HOST_BASE_URL=
MUSICPILOT_REAL_HOST_API_TOKEN=
MUSICPILOT_PHASE8_ORGANIZE_TARGET_ROOT=

# 当前推荐的真实宿主运行模式（示例）
# MUSICPILOT_HOST_SEARCH_MODE=prefer_host
# MUSICPILOT_HOST_DISPATCH_MODE=prefer_host
# MUSICPILOT_HOST_ORGANIZE_MODE=prefer_host
# MUSICPILOT_HOST_VALIDATION_MATRIX_PATH=/Users/lihuanhuan/PycharmProjects/MusicPilot/backend/data/host_validation_matrix.latest.json
# 推荐配合 `/health` 与 `/api/probe/validation-matrix` 一起查看当前 active adapter 与最新验证产物。
# Phase 10 breaking cleanup 后，旧 SQLite 需要执行 `python -m app.db_init --rebuild` 重建。
# Metadata provider:
# - `seed`：本地 seed metadata
# - `musicbrainz`：实时查询 MusicBrainz Artist / Album / Track 搜索与详情
# 建议在真实模式下自定义更明确的 User-Agent。
# Chart provider:
# - `mock`：本地 chart seed
# - `listenbrainz`：实时查询 ListenBrainz sitewide artists / recordings
# 第一版只接艺人榜和单曲榜，专辑榜待后续补 release-group 对齐。

# Organize strategy
MUSICPILOT_ORGANIZE_LIBRARY_TYPE=music
MUSICPILOT_ORGANIZE_ROOT_PATH=/library/musicpilot/library
MUSICPILOT_ORGANIZE_ARTIST_DIR_TEMPLATE={artist_name}
MUSICPILOT_ORGANIZE_ALBUM_DIR_TEMPLATE={artist_name}/{year} - {album_title}
MUSICPILOT_ORGANIZE_TRACK_FILE_TEMPLATE={track_title}.{format_ext}
MUSICPILOT_ORGANIZE_CONFLICT_POLICY=skip_existing
